# Copy to .env.mcp-http. It is ignored by git because it holds a bearer token.
# Generate a token with: openssl rand -hex 32
NETTOOLS_MCP_HTTP_BEARER_TOKEN=replace-with-a-random-secret

# The Compose initializer copies the verified host key file from this host path
# into its persistent volume. Re-enroll changed router keys before first start.
NETTOOLS_MCP_HOST_CONFIG_DIR=/home/rami/.config/nettools

# Defaults publish only on a4000 loopback. Keep this for encrypted SSH tunnels
# from a Mac; do not publish 0.0.0.0 without a TLS reverse proxy.
NETTOOLS_MCP_HTTP_BIND_ADDRESS=127.0.0.1
NETTOOLS_MCP_HTTP_BIND_PORT=8000