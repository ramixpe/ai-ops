# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# Device credentials shared across the IOS-XR lab nodes.
DEVICE_USERNAME=clab
DEVICE_PASSWORD=changeme

# Optional: use an SSH key instead of a password. When set, DEVICE_PASSWORD
# becomes an optional key passphrase.
# DEVICE_SSH_KEYFILE=/home/you/.ssh/id_ed25519

# LLM provider selection: auto | anthropic | openai | minimax | ollama
#
# What actually needs one:
#   nettools analyze / agent / demo        -- yes
#   nettools investigate                   -- only for the report and timeline.
#                                             The diagnosis is deterministic.
#   nettools investigate --no-model        -- no. Descent only.
#   nettools investigate --from-fixtures   -- no, and no devices either.
#   everything else (facts/bgp/health/...) -- no
#
# `auto` never selects ollama or minimax; both must be named explicitly.
LLM_PROVIDER=ollama

# Anthropic Claude (only needed when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# Defaults to claude-opus-5 (the current model) when unset. Pin an older
# model here if you need to; this lab's own default install leaves it unset.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: server-side refusal fallbacks (Phase 6). Only requested when the
# resolved ANTHROPIC_MODEL is in the Opus-5/Fable-5/Mythos-5 family -- set to
# 0/false/no/off to disable even for those models. No effect on other models.
# NETTOOLS_LLM_FALLBACKS=1

# Optional: opt-in for `nettools agent` (B-488). It is a free-form,
# model-driven tool-calling loop -- philosophically at odds with this
# project's central claim that the model only navigates a menu and never
# synthesises a diagnosis, Anthropic-only, and unreliable on local models.
# Default DISABLED; the command explains what it is, why it is gated, and
# points at `nettools investigate` (the deterministic alternative) until
# this is set. Like NETTOOLS_MCP_ALLOW_ACTIVE_PROBES, an unrecognized value
# stays disabled rather than silently enabling.
# NETTOOLS_ENABLE_AGENT=0

# OpenAI (only needed when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# MiniMax (only needed when LLM_PROVIDER=minimax). MiniMax serves the OpenAI
# Responses API, so this reuses the same call plumbing as OPENAI above with a
# different base URL/model -- it is never picked by LLM_PROVIDER=auto, and
# must be selected explicitly.
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3

# Local Ollama (only needed when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ornith:9b-q8_0

# Optional: JSONL audit log of every command run.
# NETTOOLS_LOG=nettools.jsonl

# Optional: gate the ping/traceroute templates (Phase 5). They generate
# traffic (unlike every other command here) even though they change no
# device state. Default enabled; set to 0/false/no/off to refuse them.
# NETTOOLS_ALLOW_ACTIVE_PROBES=1

# Optional: a SECOND, MCP-only gate on the same two templates (B-493).
# Measured 2026-08-18 (MCP-EXPERIMENT.md 12.3): a capable model followed a
# clean investigation with an UNPROMPTED ping, and NETTOOLS_ALLOW_ACTIVE_PROBES
# above -- default enabled -- did not stop it. A human typing `nettools ping`
# asked for the probe explicitly; an MCP client is a model deciding to
# generate traffic on its own. Default DISABLED. Unlike the setting above,
# an unrecognized value here stays disabled rather than silently enabling --
# only 1/true/yes/on turn it on. A refused call over MCP returns a
# structured, classified error explaining both variables, never a silent
# no-op. See mcp_server/README.md, "Active probes".
# NETTOOLS_MCP_ALLOW_ACTIVE_PROBES=0

# Optional: admission control for concurrent collection (B-444), and
# active-probe rate budgeting (B-408) -- see admission.py's module docstring
# for the measurements the two concurrency defaults below are derived from.
# An unpaced trigger (syslog -> `nettools investigate`, one OS process per
# routed event) can fan out into many concurrent collections against a
# 9-device lab; a refused request never returns an empty success -- it comes
# back `status: "error"` with an `admission` field naming why, which
# checks.py already reports as `unevaluated`, never `healthy`.
# Concurrent live collections admitted against one device at once.
# NETTOOLS_MAX_CONCURRENT_PER_DEVICE=1
# Concurrent live collections admitted fabric-wide at once.
# NETTOOLS_MAX_CONCURRENT_FABRIC=4
# How long a caller waits for a busy slot before being refused. 0 = refuse
# immediately rather than queue.
# NETTOOLS_ADMISSION_WAIT_SECONDS=0
# Where the flock lock files behind both gates above live -- deliberately a
# directory, not memory, since routed investigations are separate processes.
# NETTOOLS_ADMISSION_DIR=admission
# Active probes (ping/traceroute) admitted per device / fabric-wide per
# NETTOOLS_ACTIVE_PROBE_WINDOW_SECONDS -- a stated policy choice, not a
# measured ceiling the way the two concurrency caps above are. Checked only
# when NETTOOLS_ALLOW_ACTIVE_PROBES already allows probes at all.
# NETTOOLS_MAX_ACTIVE_PROBES_PER_DEVICE=3
# NETTOOLS_MAX_ACTIVE_PROBES_FABRIC=10
# NETTOOLS_ACTIVE_PROBE_WINDOW_SECONDS=60

# Optional: where `nettools diff` / `--save` snapshots are stored.
# Defaults to ./evidence in the working directory.
# NETTOOLS_EVIDENCE_DIR=/home/you/nettools-evidence

# Optional: path to the declarative inventory YAML file.
# Defaults to ./inventory/lab.yaml in the working directory, else a path
# resolved from the installed package.
# NETTOOLS_INVENTORY=/home/you/nettools-inventory/lab.yaml

# Optional: evidence budget for `nettools analyze --fabric` / `analyze_fabric`
# (Phase 6). Characters are a cheap proxy for tokens -- see evidence_budget.py.
# Per-intent ceiling before an evidence section is truncated in the middle.
# NETTOOLS_EVIDENCE_PER_INTENT_CHARS=4000
# Ceiling across the whole fabric-wide bundle, enforced after per-intent
# truncation; sections are proportionally shrunk further if still over.
# NETTOOLS_EVIDENCE_TOTAL_CHARS=40000

# Optional: connection/read timeouts and bounded retries (Phase 7). A
# per-template read_timeout (e.g. ping/traceroute) still wins over
# NETTOOLS_READ_TIMEOUT_SECONDS when set. Retries apply only to transient
# transport failures -- never to a command the allowlist refused.
# NETTOOLS_CONNECT_TIMEOUT_SECONDS=10
# NETTOOLS_READ_TIMEOUT_SECONDS=10
# NETTOOLS_BANNER_TIMEOUT_SECONDS=15
# NETTOOLS_COMMAND_RETRIES=2
# NETTOOLS_RETRY_BACKOFF_SECONDS=0.5

# Optional: evidence storage backend (Phase 7). "files" (default) keeps
# evidence/<device>/*.json; "sqlite" stores everything in one queryable
# evidence.db (stdlib sqlite3, no new dependency) under the same directory.
# NETTOOLS_EVIDENCE_BACKEND=files

# Optional: size-based rotation for NETTOOLS_LOG (Phase 7), so the JSONL audit
# log no longer grows forever. max_bytes <= 0 disables rotation.
# NETTOOLS_LOG_MAX_BYTES=10485760
# NETTOOLS_LOG_BACKUP_COUNT=5

# Optional: where device credentials actually come from (Phase 8). "env"
# (default) reads the value of each credential group's named environment
# variable directly. "file" reads that same named variable's value as a
# *file path* instead (the Docker/Kubernetes secrets convention, e.g. one
# secret mounted per file under /run/secrets/); see credential_resolver.py
# for the pluggable resolver interface and what a real secret-manager
# backend (Vault, AWS Secrets Manager, ...) would need to implement --
# neither is shipped here, since there is no such service in this lab to
# test against.
# NETTOOLS_CREDENTIAL_PROVIDER=env

# Optional: attribute NETTOOLS_LOG audit records to an operator (Phase 8).
# Provenance only, never authorization -- see network_tools._resolve_actor.
# Falls back to the OS login user when unset.
# NETTOOLS_ACTOR=

# Optional: persist `nettools metrics` counters to a file so they accumulate
# across separate `nettools` invocations (Phase 8) -- each CLI command is its
# own process, so without this, metrics only reflect activity within that one
# process (still meaningful for a single call touching many devices, e.g.
# `nettools fabric bgp`, or for the long-lived MCP server). Unset (the
# default) keeps metrics in-memory only, so nothing is ever written to disk
# unless you opt in.
# NETTOOLS_METRICS_FILE=metrics.json

# Where the diagnosis accuracy ledger is appended (B-485). Unset means
# diagnoses are recorded in memory only and nothing accumulates between runs.
# The tool records WHAT it diagnosed; only a human records whether it was right.
# NETTOOLS_DIAGNOSIS_LEDGER_FILE=evidence/diagnoses.jsonl

# Declarative maintenance-window table (B-483) -- a YAML list of silences,
# each with an optional device/rule/subject (all AND'd when present) and a
# mandatory expires_at. health.py's evaluate_device_with_silences /
# evaluate_fabric_with_silences load and apply this automatically. Unset
# means no silences are loaded -- every finding pages exactly as if this
# feature did not exist, never an error. A silenced finding always stays
# visible in the report; only paging severity/exit code treat it as
# expected. See health.py's module docstring for the full file format.
# NETTOOLS_SILENCE_FILE=silences.yaml

# Directory for the ticket -- one append-only markdown flight recorder per
# interaction (B-446), the escalation-grade run bundle
# docs/OPERATIONS-REVIEW.md asks for. Unlike the ledger above, this has a
# real default (below) rather than opt-in-only: a ticket is the deliverable
# a human pastes into a real ticketing system, not an accumulating corpus.
# Defaults to ./tickets in the working directory.
# NETTOOLS_TICKET_DIR=tickets

# Directory for session memory (B-407) -- one small JSON pointer per
# interactive session (device/subject/flow/ticket of that session's most
# recent `nettools investigate` turn), so a later "it" in the same session
# resolves without restating it. Overwritten each turn, never appended. Same
# posture as NETTOOLS_TICKET_DIR above: a real default rather than
# opt-in-only. Defaults to ./session_memory in the working directory.
# NETTOOLS_SESSION_MEMORY_DIR=session_memory

# ---------------------------------------------------------------------------
# Report relay -- T-035. Q-007 decided 2026-08-17: Telegram.
#
# Outbound only. There is deliberately no command handler, no webhook listener
# and no polling loop -- an inbound path is an unauthenticated trigger surface,
# and this project has no identity provider (interfaces.md; B-301).
#
# Residency, accepted with eyes open: a hosted messenger means device names,
# management IPs and RCA text leave the estate. Fine for this lab, a policy
# question the moment it points at production. Mattermost is the self-hosted
# swap and the notifier sits behind one provider interface so the change is a
# provider, not a rewrite.
#
# What can leave is bounded structurally, not by a filter: the notifier is
# handed the *report object* and there is no parameter an evidence bundle could
# arrive in, so raw command output cannot reach this path. tests/test_notifier.py
# pins it.

# Which channel. Unset or 'none' makes `nettools investigate --notify` a no-op
# rather than an error, so the flag is safe in a cron entry written before a
# channel exists. An unknown value fails closed with a structured error.
# NETTOOLS_NOTIFIER=none

# NETTOOLS_NOTIFIER_TIMEOUT_SECONDS=10

# A credential. Put it in .env (gitignored), never here, never in a commit or a
# log line. It appears in Telegram's URL path, so the notifier redacts it from
# every error message it returns -- pinned by test.
# TELEGRAM_BOT_TOKEN=

# Who receives reports. Comma-separated allowlist. **Empty means send to
# nobody**, not "send to everybody" -- the same fail-closed rule the command
# allowlist uses.
#
# This is a delivery allowlist, not authorization. It controls where output
# goes; it grants nothing, because there is no inbound path to grant it on.
# TELEGRAM_CHAT_ID=

# Refuse to send when the rendered report exceeds this many characters, rather
# than truncating. A truncated RCA is a different claim from the one that was
# grounded, and it arrives looking complete. Telegram's own limit is 4096.
# NETTOOLS_TELEGRAM_MAX_CHARS=3500

# ---------------------------------------------------------------------------
# Added 2026-08-18 (docs-drift sweep) — two vars that shipped without entries.

# Which MCP tool surface the server registers (B-479): 'classic' (default,
# the full per-function set) or 'staged' (five stage-shaped tools plus a
# probe). Both exist so the tool-selection A/B stays measurable.
# NETTOOLS_MCP_SURFACE=classic

# Where --from-fixtures reads captured output from. Defaults to this repo's
# tests/fixtures; point it elsewhere to replay a different capture set.
# NETTOOLS_FIXTURE_DIR=tests/fixtures

# ---------------------------------------------------------------------------
# Loki log adapter -- Stage-2 M5's first evidence source that is not a
# device (logs_loki.py). Read-only: one named, validated query
# (`logs_for_device`), never a caller-supplied LogQL string. Not wired into
# any rung/check or into the CLI/MCP surface by this change -- it is exposed
# for a future wide-step consumer to call.
#
# Base URL of the Loki instance. Defaults to the lab's management-network
# address as measured 2026-08-15/18 (docs/build/discovery-loki.md) -- a
# container IP, not a guaranteed-stable service address. Override this in
# any environment where that measurement does not hold.
# NETTOOLS_LOKI_URL=http://172.20.250.103:3100

# HTTP timeout for a Loki query_range call.
# NETTOOLS_LOKI_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Prometheus metrics adapter -- Stage-2 M5b's second temporal-evidence source
# (metrics_prometheus.py). Read-only: two named, validated queries
# (`interface_rate_history`, `isis_adjacency_history`), never a
# caller-supplied PromQL string. Not wired into any rung/check or into the
# CLI/MCP surface by this change -- it is exposed for a future wide-step
# consumer to call.
#
# Base URL of the Prometheus instance. Defaults to the lab's
# management-network address as measured 2026-08-15/19
# (docs/build/discovery-alerting.md) -- a container IP, not a
# guaranteed-stable service address. Override this in any environment where
# that measurement does not hold.
# NETTOOLS_PROMETHEUS_URL=http://172.20.250.102:9090

# HTTP timeout for a Prometheus query_range/series call.
# NETTOOLS_PROMETHEUS_TIMEOUT_SECONDS=10

# How far back (seconds) the existence check (/api/v1/series) looks to tell
# "this series has never been observed" apart from "it stopped being
# scraped", when a range query returns zero points. Defaults to Prometheus's
# own measured retention (one week).
# NETTOOLS_PROMETHEUS_EXISTENCE_LOOKBACK_SECONDS=604800

# B-512 (Job 2): both adapters above are now also exposed as MCP tools
# (get_lab_logs, get_lab_interface_rate_history,
# get_lab_isis_adjacency_history) -- a THIRD gate, separate from
# NETTOOLS_MCP_ALLOW_ACTIVE_PROBES above. Default ENABLED, the opposite
# posture from that gate: a model cannot choose *where* these calls go (the
# URL is set by the two variables above, never a tool parameter), so the
# traffic-steering risk NETTOOLS_MCP_ALLOW_ACTIVE_PROBES exists to close does
# not apply. Set to 0/false/no/off to disable (e.g. a deployment with no
# Loki/Prometheus reachable, so a model is never left waiting out a timeout
# on a tool that can never succeed); an unrecognized value stays enabled.
# See mcp_server/README.md, "External-source tools".
# NETTOOLS_MCP_ALLOW_EXTERNAL_SOURCES=1

# ---------------------------------------------------------------------------
# NetBox inventory collector -- Stage-2 M3b (netbox.py). NetBox is DERIVED
# from parsed device evidence, never hand-maintained (stage-2-architecture.md
# §4) -- see the module docstring for the full reasoning.
#
# build_records()/describe_writes()/format_plan() are pure and need none of
# this -- a dry run (write_records()'s default) needs no NetBox reachable, no
# `pynetbox` installed, and no credentials set at all.
#
# Base URL of the NetBox instance. Only read when write_records(dry_run=False)
# is actually called.
# NETBOX_URL=http://netbox:8080

# NetBox API token. Never commit this, never log it -- redacted from every
# exception message write_records() can raise, the same discipline
# NEO4J_PASSWORD (graph.py) and TELEGRAM_BOT_TOKEN (notifier.py) follow.
# NETBOX_TOKEN=

# The second, independent gate a real write needs, on top of passing
# dry_run=False explicitly. Default DISABLED. Like NETTOOLS_ENABLE_AGENT and
# NETTOOLS_MCP_ALLOW_ACTIVE_PROBES, an unrecognized value stays disabled
# rather than silently enabling -- only 1/true/yes/on turn it on.
# NETTOOLS_NETBOX_WRITE_ENABLED=0

# The read half (this task): netbox.run_named_read, behind
# get_lab_netbox_inventory/get_lab_netbox_topology (MCP). Reads the SAME
# NETBOX_URL/NETBOX_TOKEN above -- never a second credential pair. HTTP
# timeout for one read; same default as NETTOOLS_LOKI_TIMEOUT_SECONDS/
# NETTOOLS_PROMETHEUS_TIMEOUT_SECONDS.
# NETTOOLS_NETBOX_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# neo4j topology graph -- graph.py (B-517). A PROJECTION of this fabric's own
# parsed LLDP/IS-IS evidence (stage-2-architecture.md §2.3), never a second
# place topology gets typed in -- see the module docstring.
#
# build_graph() is pure and needs none of this -- no neo4j reachable, no
# `neo4j` driver installed, no credentials set at all. Only write_graph()
# (the operator-run collector) and the read half behind
# get_lab_graph_topology (MCP, gated the same as the NetBox/Loki/Prometheus
# tools by NETTOOLS_MCP_ALLOW_EXTERNAL_SOURCES) touch these.
#
# No default URI or password is offered -- guessing either wrong means
# silently writing to (or reading "success" from) the wrong database, worse
# than refusing to run (the same argument write_graph's own docstring makes).
# In this lab, neo4j is a docker container with no port published to the
# host (`docker port sota-lab-platform-neo4j-1` returns nothing) -- from
# INSIDE the compose network a service reaches it at bolt://neo4j:7687 (the
# container's own DNS alias); from the host (where this project's own
# process runs) it is the container's IP on that network, found with
# `docker inspect sota-lab-platform-neo4j-1 --format
# '{{.NetworkSettings.Networks.sota-lab-platform_labnet.IPAddress}}'` --
# stable across container restarts, not guaranteed forever.
# NEO4J_URI=bolt://172.19.0.16:7687

# NEO4J_USER defaults to "neo4j" only because that is the fixed, non-secret
# account name every stock neo4j deployment uses (the *password* is the
# secret; the username is not) -- see write_graph's own docstring.
# NEO4J_USER=neo4j

# Read from the container's own NEO4J_AUTH (`docker inspect
# sota-lab-platform-neo4j-1 --format '{{range .Config.Env}}{{println .}}
# {{end}}'`, `user/password`) -- never committed, never logged. Redacted from
# every exception message write_graph()/the read half can raise, the same
# discipline NETBOX_TOKEN follows.
# NEO4J_PASSWORD=

# Optional: select a non-default database. Unset uses neo4j's own default
# ("neo4j").
# NEO4J_DATABASE=

# Connection and read-transaction-retry timeout for one neo4j read
# (graph.run_named_read, behind get_lab_graph_topology). Measured
# 2026-08-19: with no bound, the neo4j driver's own connect-retry backoff
# left an unreachable-server call still retrying past 60s. Same default as
# NETTOOLS_LOKI_TIMEOUT_SECONDS/NETTOOLS_PROMETHEUS_TIMEOUT_SECONDS/
# NETTOOLS_NETBOX_TIMEOUT_SECONDS.
# NETTOOLS_NEO4J_TIMEOUT_SECONDS=10
