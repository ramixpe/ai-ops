# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# Device credentials shared across the IOS-XR lab nodes.
DEVICE_USERNAME=clab
DEVICE_PASSWORD=changeme

# Optional: use an SSH key instead of a password. When set, DEVICE_PASSWORD
# becomes an optional key passphrase.
# DEVICE_SSH_KEYFILE=/home/you/.ssh/id_ed25519

# LLM provider selection: auto | anthropic | openai | ollama
LLM_PROVIDER=ollama

# Anthropic Claude (only needed when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# Defaults to claude-opus-5 (the current model) when unset. Pin an older
# model here if you need to; this lab's own default install leaves it unset.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: server-side refusal fallbacks (Phase 6). Only requested when the
# resolved ANTHROPIC_MODEL is in the Opus-5/Fable-5/Mythos-5 family -- set to
# 0/false/no/off to disable even for those models. No effect on other models.
# NETTOOLS_LLM_FALLBACKS=1

# OpenAI (only needed when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Local Ollama (only needed when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ornith:9b-q8_0

# Optional: JSONL audit log of every command run.
# NETTOOLS_LOG=nettools.jsonl

# Optional: gate the ping/traceroute templates (Phase 5). They generate
# traffic (unlike every other command here) even though they change no
# device state. Default enabled; set to 0/false/no/off to refuse them.
# NETTOOLS_ALLOW_ACTIVE_PROBES=1

# Optional: where `nettools diff` / `--save` snapshots are stored.
# Defaults to ./evidence in the working directory.
# NETTOOLS_EVIDENCE_DIR=/home/you/nettools-evidence

# Optional: path to the declarative inventory YAML file.
# Defaults to ./inventory/lab.yaml in the working directory, else a path
# resolved from the installed package.
# NETTOOLS_INVENTORY=/home/you/nettools-inventory/lab.yaml

# Optional: evidence budget for `nettools analyze --fabric` / `analyze_fabric`
# (Phase 6). Characters are a cheap proxy for tokens -- see evidence_budget.py.
# Per-intent ceiling before an evidence section is truncated in the middle.
# NETTOOLS_EVIDENCE_PER_INTENT_CHARS=4000
# Ceiling across the whole fabric-wide bundle, enforced after per-intent
# truncation; sections are proportionally shrunk further if still over.
# NETTOOLS_EVIDENCE_TOTAL_CHARS=40000

# Optional: connection/read timeouts and bounded retries (Phase 7). A
# per-template read_timeout (e.g. ping/traceroute) still wins over
# NETTOOLS_READ_TIMEOUT_SECONDS when set. Retries apply only to transient
# transport failures -- never to a command the allowlist refused.
# NETTOOLS_CONNECT_TIMEOUT_SECONDS=10
# NETTOOLS_READ_TIMEOUT_SECONDS=10
# NETTOOLS_BANNER_TIMEOUT_SECONDS=15
# NETTOOLS_COMMAND_RETRIES=2
# NETTOOLS_RETRY_BACKOFF_SECONDS=0.5

# Optional: evidence storage backend (Phase 7). "files" (default) keeps
# evidence/<device>/*.json; "sqlite" stores everything in one queryable
# evidence.db (stdlib sqlite3, no new dependency) under the same directory.
# NETTOOLS_EVIDENCE_BACKEND=files

# Optional: size-based rotation for NETTOOLS_LOG (Phase 7), so the JSONL audit
# log no longer grows forever. max_bytes <= 0 disables rotation.
# NETTOOLS_LOG_MAX_BYTES=10485760
# NETTOOLS_LOG_BACKUP_COUNT=5
