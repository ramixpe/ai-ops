.venv/
__pycache__/
*.pyc
.env
.env.*
!*.example
.clab/
clab-*/
*.log
# ...except round logs, which are evidence beside their samples (OBS-131).
!evidence-archive/**/*.log
*.jsonl
# ...except round payloads. A round's samples ARE the evidence (chaos-harness
# §6.1d) and a broad `*.jsonl` swept them into "untracked scratch", which is one
# `git clean` from gone -- and two round-7 directories were in fact lost that
# way. Archiving means committed.
!evidence-archive/**/*.jsonl
*.tar
*.tar.gz
*.tar.xz
images/
# Transient device snapshots -- the evidence STORE, which is a cache.
# `evidence-archive/` is the opposite: a round's payload, and it is tracked.
# The two names are one character apart and mean opposite things; see OBS-131
# for why a blanket pattern over a directory whose contents ARE the record is
# the failure that has no signal.
evidence/
*.egg-info/
/build/
.DS_Store
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# docs/diagrams/facts.py's speedup cache for the expensive measurements (a
# full pytest run, a real `investigate --from-fixtures` invocation) -- a
# derived, machine-local artifact, invalidated by its own tree signature.
docs/diagrams/.facts_cache.json

# install-docs.sh backups
.docs-backup-*/

# Agent worktrees and session scratch (never committed)
.claude/

# Flight-recorder tickets (B-446). A ticket is a RUN ARTEFACT, like the evidence
# store and unlike evidence-archive/: it records one interaction that already
# happened, and committing them would put every test run's output in history.
# 113 of them were swept into a01b70d by `git add -A` before this line existed
# (OBS-150's mistake, second occurrence).
tickets/

# Admission-control lock files and active-probe budget windows (B-408/B-444).
# Real, live, run-local state -- flock markers and sliding-window timestamp
# logs -- never a record worth keeping, same reasoning as evidence/ and
# tickets/ above.
admission/

# B-407's pointer store, same reason tickets/ and admission/ are here: a
# durable store defaulting to a path inside the repo will be written by any
# real run and by any test that forgets to isolate it. OBS-172 is the version
# of this that reached a commit -- 113 test tickets -- and it has now recurred
# twice more with new stores. The pattern is the finding: a new store inherits
# none of the containment the previous ones learned.
session_memory/
